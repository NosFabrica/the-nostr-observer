# Gradle / JVM
.gradle/
build/
*.class
*.jar
# After *.jar, not before it: the last matching pattern wins, so with the
# negation first the wrapper jar stayed ignored and CI checked out a tree whose
# ./gradlew could not start.
!gradle/wrapper/gradle-wrapper.jar
*.log
hs_err_pid*

# IDE
.idea/
*.iml
.vscode/

# Local config and secrets
.env
.env.*
local.properties
*.local.conf

# Local dry runs of the CLI, and the skill's printed papers plus corpus/digest
editions/
# observer-pages: the public shelf, staged for Vercel
dist/
.vercel/

# OS
.DS_Store
