# Gradle / JVM
.gradle/
build/
*.class
*.jar
# After *.jar, not before it: the last matching pattern wins, so with the
# negation first the wrapper jar stayed ignored and CI checked out a tree whose
# ./gradlew could not start.
!gradle/wrapper/gradle-wrapper.jar
*.log
hs_err_pid*

# IDE
.idea/
*.iml
.vscode/

# Local config and secrets
.env
.env.*
local.properties
*.local.conf

# Runtime data
data/
*.db
*.sqlite
*.sqlite3

# OS
.DS_Store

# Editions, and the working files a run leaves behind
#
# A run writes these into the reader's working directory, which is a checkout
# often enough that they show up as untracked here. None of them are source:
# corpus.json is a megabyte-plus dump of other people's posts, and the edition
# is one reader's paper for one day, reproducible from the npub and the date.
observer-*.html
corpus.json
corpus.err
digest.md
readiness.json
