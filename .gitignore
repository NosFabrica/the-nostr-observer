# Gradle / JVM
.gradle/
build/
*.class
*.jar
# After *.jar, not before it: the last matching pattern wins, so with the
# negation first the wrapper jar stayed ignored and CI checked out a tree whose
# ./gradlew could not start.
!gradle/wrapper/gradle-wrapper.jar
*.log
hs_err_pid*

# IDE
.idea/
*.iml
.vscode/

# Local config and secrets
.env
.env.*
local.properties
*.local.conf

# Runtime data
data/
*.db
*.sqlite
*.sqlite3

# OS
.DS_Store

# Run outputs from printing an edition (scripts write these to the cwd)
readiness.json
corpus.json
digest.md
observer-*-with-art.html
