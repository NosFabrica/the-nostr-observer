# Gradle / JVM
.gradle/
build/
*.class
*.jar
# After *.jar, not before it: the last matching pattern wins, so with the
# negation first the wrapper jar stayed ignored and CI checked out a tree whose
# ./gradlew could not start.
!gradle/wrapper/gradle-wrapper.jar
*.log
hs_err_pid*

# IDE
.idea/
*.iml
.vscode/

# Local config and secrets
.env
.env.*
local.properties
*.local.conf

# Runtime data
data/
*.db
*.sqlite
*.sqlite3

# OS
.DS_Store

# Observer run output. The skill writes readiness.json, corpus.json, digest.md
# and the edition itself into the CURRENT directory, which is the reader's --
# so running it inside this checkout leaves four untracked files behind every
# time. The corpus alone is ~2 MB of other people's posts, and the edition is
# one person's personal front page; neither belongs in the source tree.
readiness.json
corpus.json
digest.md
observer-*.html
